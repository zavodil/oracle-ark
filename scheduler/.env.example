# Oracle Scheduler Configuration
# Copy this file to .env and fill in the values

# ===== Required =====

# Coordinator URL for WASI calls and public storage
COORDINATOR_URL=https://api.outlayer.fastnear.com

# Project identification
PROJECT_OWNER=alice.near
PROJECT_NAME=price-oracle
PROJECT_UUID=p0000000000000001

# Payment key for WASI calls (format: owner:nonce:secret)
# Create via OutLayer dashboard or CLI
PAYMENT_KEY=alice.near:0:your_secret_key_here

# ===== Exchange configs =====

# There is no local tokens file. The scheduler reads exchange configs from
# OutLayer public storage under the key `config:assets` (fetched via the
# public-storage batch API and cached for ~10 minutes). This requires
# `sync_asset_configs` to have been called on the oracle contract first.

# ===== API Keys (Optional) =====

# Universal API key for price sources that need authentication
# Used for CoinGecko Pro, custom sources, etc.
# API_KEY=your_api_key

# ===== Update Triggers =====

# Time-based: update at least every N seconds
# Even if price hasn't changed, WASI will be called after this interval
UPDATE_INTERVAL_SECS=60

# Faster cadence for the assets in PRIORITY_ASSETS. Between two full refreshes, only those
# assets are refreshed — a much smaller call than the full set.
#
# 0 means "due on every poll". The effective cadence is then
#   POLL_INTERVAL_SECS + the scheduler's own batch fetch + the refresh call
# which measures ~13-15s, and that is what keeps the priority assets under a 20s ceiling.
# A positive value adds on top: 10 here yields ~25s, not 10s.
UPDATE_INTERVAL_PRIORITY_SECS=0

# Assets refreshed on the priority interval above (comma-separated).
# ETH is eth.bridge.near — the old `aurora` asset was the Aurora EVM account used as an ETH
# feed and no longer exists; the AURORA token is a separate asset.
PRIORITY_ASSETS=wrap.near,nbtc.bridge.near,eth.bridge.near

# ===== Source tiers =====
# Venues kept OUT of the fast and full refreshes and updated on their own slow cadence.
# Chainlink is an EVM eth_call through Multicall3 and Pyth a separate API, so both cost far
# more per refresh than an all-ticker endpoint that answers for every asset in one request.
# Excluding them is what makes a sub-20s cadence affordable.
#
# Nothing is lost by doing so: the worker MERGES each refresh into the stored record, so the
# last Pyth and Chainlink observations stay in place and keep contributing to any consumer
# whose freshness window is wide enough to include them.
SLOW_SOURCES=pyth,chainlink

# How often the slow tier above is refreshed, for every asset.
#
# Must stay comfortably BELOW the worker's canonical window (120s), not equal to it: the real
# gap is this interval + POLL_INTERVAL_SECS + the call itself. At 120 these venues would drift
# past 120s old for part of every cycle, drop out of the published aggregate and reappear on the
# next refresh — a price that moves because the source set changed, not because the market did.
SLOW_SOURCE_INTERVAL_SECS=90

# Price-based: update if price changed more than N%
# Triggers update BEFORE interval if price moved significantly
# Set to 0 to disable price-based triggers
PRICE_DIFF_THRESHOLD_PERCENT=1.0

# ===== Refresh Parallelism =====
# WASI fetches its sources sequentially, so a single call carrying every token is slow.
# The refresh is therefore split into groups that run concurrently.

# Max tokens per WASI cache-refresh call.
# The worker sends ONE batch request per source for the whole set, so groups multiply those
# requests rather than splitting work: N groups = N full pulls of every all-tickers endpoint,
# which rate-limits sources like CoinGecko and makes assets silently lose a source.
# Keep this above the number of tracked assets so the refresh stays a single call.
GROUP_MAX_TOKENS=64

# How many refresh groups may be in flight at once
FETCH_CONCURRENCY=3

# ===== Aggregation =====

# How to aggregate prices from multiple sources
# Options: "median" (default, robust against outliers), "average", "weighted_average"
AGGREGATION_METHOD=median

# Minimum number of sources required to calculate price
# If fewer sources return data, update will fail
MIN_SOURCES_NUM=1

# ===== Contract Update (Optional) =====

# If true, WASI will also call report_prices on the oracle contract
# This updates on-chain price cache in addition to WASI public storage
# Requires secrets (PROTECTED_ORACLE_KEY etc) — set SECRETS_PROFILE and SECRETS_ACCOUNT_ID below
UPDATE_CONTRACT_ENABLED=false

# How often prices are pushed on-chain, in seconds.
# Deliberately separate from the refresh cadence above: refreshing the cache is cheap and frequent,
# while every push costs gas. One push covers all tokens in a single call, so raising the refresh
# rate (or FETCH_CONCURRENCY) never multiplies transactions.
CONTRACT_PUSH_INTERVAL_SECS=300

# Oracle contract ID to update (required if UPDATE_CONTRACT_ENABLED=true)
# ORACLE_CONTRACT_ID=oracle.near

# Secrets profile and account — injects ALL secrets of this profile into WASI env.
# Required if WASI needs any secrets (PROTECTED_ keys, API keys, etc.)
#
# These are resolved against the PROJECT the call is made to, not against a GitHub repo, so
# renaming or forking the repository does not affect them. The profile is a plain name, not
# necessarily "default" — the mainnet deployment uses:
#
#   SECRETS_PROFILE=oracle
#   SECRETS_ACCOUNT_ID=price-oracle.near
#
# SECRETS_PROFILE=default
# SECRETS_ACCOUNT_ID=alice.near

# ===== Telegram Alerts (Optional) =====

# Bot token from @BotFather
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID to send alerts to (can be negative for groups)
# TELEGRAM_CHAT_ID=-1001234567890

# ===== Logging =====

# Log level: trace, debug, info, warn, error
RUST_LOG=info
